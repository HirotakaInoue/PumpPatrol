{
  "name": "PumpPatrol-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "NODE_VERSION": "20"
    }
  },
  "workspaceFolder": "/workspaces/PumpPatrol",
  "remoteUser": "vscode",
  "postCreateCommand": "corepack enable && corepack prepare pnpm@latest --activate",
  "forwardPorts": [
    3000,
    8080
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "openai.chatgpt"
      ]
    }
  }
}
